mas japanese_AE {
    workspace auction_ws {
        artifact auction: auction.JapaneseAuctionArtifact("notebook",50,10);
    }
    agent auctioneer: auctioneer.asl
    agent buyer1: buyer.asl { beliefs: max_price(100) }
    agent buyer2: buyer.asl { beliefs: max_price(130) }
    agent buyer3: buyer.asl { beliefs: max_price(160) }
}
